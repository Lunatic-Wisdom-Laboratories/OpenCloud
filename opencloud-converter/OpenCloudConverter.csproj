<Project Sdk="Godot.NET.Sdk/4.3.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>OpenCloud.Converter</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- The engine's data model and file system, shared with the converter. Engine scenes and
         node scripts stay out: the converter only builds node trees to write them as glTF. -->
    <Compile Include="../opencloud-godot/src/Core/**/*.cs" Link="Engine/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../opencloud-godot/src/Assets/**/*.cs" Exclude="../opencloud-godot/src/Assets/**/*Loader.cs;../opencloud-godot/src/Assets/Maps/MapSky.cs" Link="Engine/Assets/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../opencloud-godot/src/Rendering/GameMaterialFactory.cs" Link="Engine/Rendering/GameMaterialFactory.cs" />
    <Compile Include="../opencloud-godot/src/Game/Items/ItemCatalog.cs" Link="Engine/Game/Items/ItemCatalog.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ZstdSharp.Port" Version="0.8.1" />
  </ItemGroup>
</Project>
